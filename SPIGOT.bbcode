[*][FONT=Book Antiqua]%venturacalendar_month_<month-name>_days%[/FONT]
[*][FONT=Book Antiqua]%venturacalendar_event_<event-config-name>_start%[/FONT]
[*][FONT=Book Antiqua]%venturacalendar_event_<event-config-name>_end%[/FONT]
[*][FONT=Book Antiqua]%venturacalendar_event_<event-config-name>_description%[/FONT]
[*][FONT=Book Antiqua]%venturacalendar_newday_message%[/FONT]
[*][FONT=Book Antiqua]%venturacalendar_actionbar_message%[/FONT]
[*][FONT=Book Antiqua]%venturacalendar_date_event_name%[/FONT]
[*][FONT=Book Antiqua]%venturacalendar_date_event_description%[/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_tick%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_second%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_minute%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_hour%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_day%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_day_name%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_dayofweek%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_week%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_month%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_month_name%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_season_name%[/SIZE][/FONT]
[*][FONT=Book Antiqua][SIZE=4]%venturacalendar_date_year%[/SIZE][/FONT]
